{
  "entities": {
    "imports": {
      "title": "Imported Files",
      "description": "Metadata for files imported via Shortcut",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "description": "Original name of the file"
        },
        "storagePath": {
          "type": "string",
          "description": "Path to the file in Firebase Storage"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the file was uploaded"
        }
      },
      "required": ["fileName", "storagePath", "createdAt"]
    }
  },
  "firestore": {
    "/imports/{importId}": {
      "schema": "imports",
      "description": "Collection of imported file metadata"
    }
  }
}
